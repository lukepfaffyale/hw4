# Copy this file to .env (same folder) and fill in the values. Never commit .env.
# The back end reads backend/.env first, then this root .env; either location works.

# Required: the Portkey key for the chat assistant (Yale SSO, workspace SOMEDU MBA Core AI Class)
PORTKEY_API_KEY=your-key-here
# Model routed through Portkey. Allowed: gpt-5.6-luna (default), gpt-5.6-terra, gpt-5.6-sol, gpt-6-astra, gpt-6-luna
OPENAI_MODEL=gpt-5.6-luna

# Sessions: any long random string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave blank and the server makes a fresh one at every start (sessions then end on restart).
SESSION_SECRET=your-long-random-string-here

# Where the front end runs (CORS allows exactly this origin)
FRONTEND_ORIGIN=http://localhost:5173

# Optional: folder holding campus_customs.db and products/. Defaults to ../data from backend/
# DATA_DIR=

# New-account password hashing: bcrypt (class rule, default) or pbkdf2 (course data-pack format).
# Login verifies both formats whatever this is set to.
PASSWORD_SCHEME=bcrypt

# Social sign-in through Supabase Auth (Google / GitHub). Leave blank to disable.
# The anon key is public by design; the service-role key is NOT needed and must not be put here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Shop staff who may see the restock queue on /staff (comma-separated account emails). Blank = none.
ADMIN_EMAILS=

# Hidden friends demo controls. HUNT_SEASON forces a season (halloween); HUNT_DATE pins the day
# (YYYY-MM-DD) so every daily friend is out. Blank = by the real date.
HUNT_SEASON=
HUNT_DATE=
