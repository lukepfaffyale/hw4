# Copy to frontend/.env.local for non-default values. Never commit real .env files.
VITE_API_URL=http://localhost:8000

# Social sign-in via Supabase Auth (optional). The anon key is public by design.
# Leave both blank to show the social buttons disabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
